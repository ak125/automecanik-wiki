{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit document passages for candidate authoring",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "slug",
        "lang",
        "source_language",
        "prepared_at",
        "lineage_id",
        "template_sha256",
        "receipt_path",
        "receipt_sha256",
        "claims"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,78}[a-z0-9]$"
        },
        "lang": {
          "enum": [
            "fr",
            "en"
          ]
        },
        "source_language": {
          "enum": [
            "fr",
            "en"
          ]
        },
        "prepared_at": {
          "type": "string",
          "format": "date"
        },
        "lineage_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "template_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_path": {
          "type": "string",
          "pattern": "^sources/auto-captures/documents/[0-9a-f]{64}\\.md$"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "start",
              "end",
              "quote",
              "statement"
            ],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "slug",
        "lang",
        "prepared_at",
        "lineage_id",
        "template_sha256",
        "claims",
        "documents"
      ],
      "properties": {
        "version": {
          "const": "1.1.0"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,78}[a-z0-9]$"
        },
        "lang": {
          "enum": [
            "fr",
            "en"
          ]
        },
        "prepared_at": {
          "type": "string",
          "format": "date"
        },
        "lineage_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "template_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "statement",
              "anchors"
            ],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "anchors": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "document_id",
                    "start",
                    "end",
                    "quote"
                  ],
                  "properties": {
                    "document_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          }
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_language",
              "receipt_path",
              "receipt_sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "source_language": {
                "enum": [
                  "fr",
                  "en"
                ]
              },
              "receipt_path": {
                "type": "string",
                "pattern": "^sources/auto-captures/documents/[0-9a-f]{64}\\.md$"
              },
              "receipt_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
